<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Suite file is the entry point for TestNG.
  Surefire reads this file instead of scanning for test classes itself.
  You control grouping, parallelism, and order from here.
-->
<suite name="Playwright Demo Suite" verbose="1">

    <!-- Run smoke tests first, then regression -->
    <test name="Smoke Tests" preserve-order="true">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.demo.playwright.tests.LoginTest"/>
            <class name="com.demo.playwright.tests.InventoryTest"/>
        </classes>
    </test>

    <test name="Regression Tests" preserve-order="true">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.demo.playwright.tests.LoginTest"/>
            <class name="com.demo.playwright.tests.InventoryTest"/>
        </classes>
    </test>

</suite>
